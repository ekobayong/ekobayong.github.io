          <line class="dw s-o" data-p="1" x1="231" y1="336" x2="231" y2="304"></line>
          <!-- bookshelf -->
          <path class="dw s-o" data-p="1" d="M560 392 V310 M592 392 V310 M560 310 H592"></path>
          <path class="dw s-t" data-p="2" d="M560 330 H592 M560 350 H592 M560 370 H592"></path>
          <path class="dw s-t" data-p="2" d="M564 392 V314 M570 392 V334 M576 392 V354 M582 392 V374"></path>
