          <rect class="fp" x="143" y="400" width="23" height="24" fill="url(#poche)" stroke="none"></rect>
          <rect class="fp" x="593" y="400" width="23" height="24" fill="url(#poche)" stroke="none"></rect>

          <!-- cut walls / slab / foundations -->
          <path class="dw s-h" data-p="0" d="M150 296 V400 M159 303 V400"></path>
          <path class="dw s-h" data-p="0" d="M600 272 V400 M609 279 V400"></path>
          <path class="dw s-h" data-p="0" d="M150 392 H609 M150 400 H609"></path>
          <path class="dw s-h" data-p="0" d="M143 400 V424 H166 V400 M593 400 V424 H616 V400"></path>
          <!-- cut roofs -->
          <path class="dw s-h" data-p="0" d="M142 296 L400 254 M150 303 L400 262"></path>
          <path class="dw s-h" data-p="0" d="M418 238 L618 272 M418 246 L616 279"></path>
          <!-- clerestory glazing -->
          <path class="dw s-o" data-p="1" d="M400 254 V296 H418 V238"></path>
          <line class="dw s-t" data-p="2" x1="406" y1="250" x2="406" y2="296"></line>
          <line class="dw s-t" data-p="2" x1="412" y1="244" x2="412" y2="296"></line>
          <!-- dashed sun rays through the clerestory -->
          <path class="dw s-d s-dash" data-p="2" d="M416 246 L322 396 M426 252 L342 396 M436 258 L362 396"></path>
          <!-- soapstone stove -->
          <rect class="dw s-o" data-p="1" x="216" y="336" width="30" height="56"></rect>
