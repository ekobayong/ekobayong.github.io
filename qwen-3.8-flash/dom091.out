<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pavilion 07 — Self-Drawing Blueprint · Halden Studio</title>
<style>
  :root{
    --ink:#ffffff;
    --ink-soft:rgba(255,255,255,.72);
    --ink-faint:rgba(255,255,255,.28);
    --accent:#ffd978;
    --grid-fine:rgba(255,255,255,.08);
    --grid-major:rgba(255,255,255,.16);
    --mono:ui-monospace,"Cascadia Mono","Courier New",monospace;
    --serif:Georgia,"Iowan Old Style","Times New Roman",serif;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ overflow-x:hidden; }
  body{
    min-height:100vh;
    background:linear-gradient(135deg, #0b3d91 0%, #14479f 55%, #1a4fa3 100%);
    font-family:var(--mono);
    color:var(--ink);
    overflow-x:hidden;
  }
  /* paper layer for print mode, cross-faded */
  body::before{
    content:""; position:fixed; inset:0; z-index:0; pointer-events:none;
    background:linear-gradient(135deg, #f4f1e8 0%, #f0ecdf 55%, #ece7da 100%);
    opacity:0; transition:opacity .8s ease;
  }
  body.print::before{ opacity:1; }
  /* grids: two stacks so the color can crossfade */
  .grid-layer{ position:fixed; inset:0; z-index:1; pointer-events:none; transition:opacity .8s ease; }
  .grid-blue{
    opacity:1;
    background:
      repeating-linear-gradient(0deg, var(--grid-major) 0 1px, transparent 1px 80px),
      repeating-linear-gradient(90deg, var(--grid-major) 0 1px, transparent 1px 80px),
      repeating-linear-gradient(0deg, var(--grid-fine) 0 1px, transparent 1px 16px),
      repeating-linear-gradient(90deg, var(--grid-fine) 0 1px, transparent 1px 16px);
  }
  .grid-paper{
    opacity:0;
    background:
      repeating-linear-gradient(0deg, rgba(11,61,145,.18) 0 1px, transparent 1px 80px),
      repeating-linear-gradient(90deg, rgba(11,61,145,.18) 0 1px, transparent 1px 80px),
      repeating-linear-gradient(0deg, rgba(11,61,145,.09) 0 1px, transparent 1px 16px),
      repeating-linear-gradient(90deg, rgba(11,61,145,.09) 0 1px, transparent 1px 16px);
  }
  body.print .grid-blue{ opacity:0; }
  body.print .grid-paper{ opacity:1; }
  /* feTurbulence noise, physical paper */
  .noise{ position:fixed; inset:0; width:100%; height:100%; z-index:2; pointer-events:none;
          mix-blend-mode:overlay; opacity:.5; }
  /* print-mode ink swap */
  body.print{
    --ink:#0b3d91;
    --ink-soft:rgba(11,61,145,.72);
    --ink-faint:rgba(11,61,145,.28);
    --accent:#c2410c;
  }

  .frame{
    position:relative; z-index:3;
    margin:14px; border:1px solid var(--ink-soft);
    transition:border-color .8s;
  }
  .frame-inner{
    margin:5px; border:1px solid var(--ink-faint);
    padding:16px 20px 18px;
    transition:border-color .8s;
  }

  /* ---------- header ---------- */
  header{ display:flex; justify-content:space-between; align-items:flex-end; gap:14px; flex-wrap:wrap;
          border-bottom:1px solid var(--ink-faint); padding-bottom:10px; transition:border-color .8s; }
  .practice{ font-variant:small-caps; letter-spacing:.28em; font-size:11px; color:var(--ink-soft); transition:color .8s; }
  h1{ font-family:var(--serif); font-weight:400; font-size:clamp(17px,2.6vw,24px); margin-top:4px;
      letter-spacing:.02em; color:var(--ink); transition:color .8s; }
  .controls{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .seg{ display:flex; border:1px solid var(--ink-soft); transition:border-color .8s; }
  .seg button{
    appearance:none; background:transparent; border:0; border-left:1px solid var(--ink-faint);
    font:400 9.5px/1 var(--mono); letter-spacing:.14em; text-transform:uppercase;
    color:var(--ink-soft); padding:8px 11px; cursor:pointer; transition:color .8s, background .25s;
  }
  .seg button:first-child{ border-left:0; }
  .seg button:hover{ color:var(--ink); }
  .seg button[aria-pressed="true"]{ background:var(--ink); color:#0b3d91; }
  body.print .seg button[aria-pressed="true"]{ color:#f4f1e8; }
  .printbtn{
    appearance:none; font:400 9.5px/1 var(--mono); letter-spacing:.14em; text-transform:uppercase;
    color:var(--ink-soft); background:transparent; border:1px solid var(--ink-faint);
    padding:8px 11px; cursor:pointer; transition:color .8s, border-color .8s;
  }
  .printbtn:hover{ color:var(--ink); border-color:var(--ink-soft); }
  .status{ display:flex; align-items:center; gap:7px; font-size:9.5px; letter-spacing:.2em; text-transform:uppercase; color:var(--ink-soft); transition:color .8s; }
  .dot{ width:7px; height:7px; border-radius:50%; background:var(--accent); animation:blink 1.1s steps(2) infinite;
        box-shadow:0 0 6px 1px rgba(255,217,120,.5); transition:background .8s; }
  .dot.done{ animation:none; opacity:.55; box-shadow:none; }
  @keyframes blink{ 50%{ opacity:.15; } }

  /* ---------- stage ---------- */
  .stage{ position:relative; margin-top:12px; }
  svg.sheet-svg{ display:block; width:100%; height:auto; }
  .dw, .fp, text, line, path, rect, circle, ellipse, polyline, polygon{
    transition:stroke .8s, fill .8s;
  }
  .fp{ opacity:0; transition:opacity .9s ease .15s, stroke .8s; }
  g.drawn .fp{ opacity:1; }
  g.sheet{ display:none; }
  g.sheet.live{ display:block; }
  text{ fill:var(--ink); font-family:var(--mono); }
  text.t-label{ font-size:11px; letter-spacing:1.6px; }
  text.t-small{ font-size:8px; letter-spacing:1px; }
  text.t-dim{ font-size:8.5px; letter-spacing:1px; fill:var(--ink-soft); }
  text.t-faint{ fill:var(--ink-soft); }
  text.t-serif{ font-family:var(--serif); font-style:italic; }
  .s-h{ stroke:var(--ink); stroke-width:2.1; fill:none; }
  .s-o{ stroke:var(--ink); stroke-width:1.05; fill:none; }
  .s-t{ stroke:var(--ink-soft); stroke-width:.65; fill:none; }
  .s-d{ stroke:var(--ink-soft); stroke-width:.8; fill:none; }
  .s-f{ stroke:var(--ink-faint); stroke-width:.6; fill:none; }
  .s-dash{ stroke-dasharray:5 4; }
  .s-dash2{ stroke-dasharray:2 3; }
  .poche line{ stroke:var(--ink); stroke-width:.55; transition:stroke .8s; }
  .roomfill{ fill:rgba(255,220,120,0); pointer-events:all; cursor:pointer; transition:fill .18s; }
  .room:hover .roomfill{ fill:rgba(255,220,120,.22); }
  .room.pinned .roomfill{ fill:rgba(255,220,120,.22); }
  marker path{ fill:var(--ink); transition:fill .8s; }

  .tip{
    position:absolute; z-index:9; pointer-events:none; display:none;
    background:#f7f3e7; color:#17243c; border:1px solid rgba(0,0,0,.35);
    padding:6px 10px; font-size:11px; transform:translate(-50%,calc(-100% - 12px));
    box-shadow:0 4px 14px rgba(0,10,40,.45); white-space:nowrap;
  }
  .tip .nm{ font-family:var(--serif); font-size:13px; }
  .tip .ar{ font-family:var(--mono); font-size:9px; letter-spacing:.1em; opacity:.75; display:block; margin-top:1px; }
  body.print .tip{ background:#0b3d91; color:#f4f1e8; }

  /* ---------- legend + title block ---------- */
  .legend{
    display:flex; gap:26px; flex-wrap:wrap; align-items:center; margin-top:10px;
    border-top:1px solid var(--ink-faint); padding-top:9px;
    font-size:8.5px; letter-spacing:.16em; text-transform:uppercase; color:var(--ink-soft);
    transition:color .8s, border-color .8s;
  }
  .legend .li{ display:flex; align-items:center; gap:8px; }
  .legend svg{ display:block; }
  .tblock{
    margin-top:10px; border:1px solid var(--ink-soft); transition:border-color .8s;
    display:grid; grid-template-columns:repeat(auto-fit, minmax(112px,1fr));
  }
  .tb{ border-left:1px solid var(--ink-faint); padding:7px 11px 8px; transition:border-color .8s; }
  .tb:first-child{ border-left:0; }
  .tb .k{ font-size:7.5px; letter-spacing:.2em; text-transform:uppercase; color:var(--ink-soft); transition:color .8s; }
  .tb .v{ font-size:11px; letter-spacing:.06em; margin-top:3px; color:var(--ink); transition:color .8s; }
  .tb.sheetnum{ display:flex; align-items:center; justify-content:center; }
  .tb.sheetnum .v{ font-size:24px; letter-spacing:.12em; }
  @media (max-width:640px){
    .frame{ margin:8px; } .frame-inner{ padding:12px 12px 14px; }
    .tblock{ grid-template-columns:repeat(3,1fr); }
    .tb{ border-top:1px solid var(--ink-faint); }
  }
  @media (prefers-reduced-motion: reduce){
    .dot{ animation:none; }
    .fp{ transition:none; }
    *{ scroll-behavior:auto; }
  }
</style>
</head>
<body>
  <div class="grid-layer grid-blue" aria-hidden="true"></div>
  <div class="grid-layer grid-paper" aria-hidden="true"></div>
  <svg class="noise" aria-hidden="true">
    <filter id="grain"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"></feTurbulence><feColorMatrix type="saturate" values="0"></feColorMatrix></filter>
    <rect width="100%" height="100%" filter="url(#grain)" opacity="0.10"></rect>
  </svg>

  <div class="frame"><div class="frame-inner">
    <header>
      <div>
        <div class="practice">Halden Studio · Architecture</div>
        <h1>Pavilion 07 — Reading Room in the Birch Grove</h1>
      </div>
      <div class="controls">
        <div class="seg" role="group" aria-label="Sheet selector">
          <button data-sheet="0" aria-pressed="true">A-101 Plan</button>
          <button data-sheet="1" aria-pressed="false">A-201 Elevations</button>
          <button data-sheet="2" aria-pressed="false">A-301 Section</button>
        </div>
        <button class="printbtn" id="printBtn" aria-pressed="false">Print mode</button>
        <span class="status"><i class="dot done" id="statDot"></i><span id="statTxt">Sheet complete</span></span>
      </div>
    </header>

    <div class="stage" id="stage">
      <svg class="sheet-svg" viewBox="0 0 800 500" role="img" aria-label="Architectural drawing stage">
        <defs>
          <pattern id="poche" class="poche" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="0" y2="6"></line>
          </pattern>
          <pattern id="ground" class="poche" patternUnits="userSpaceOnUse" width="8" height="8">
            <path d="M0 8 L8 0 M-2 2 L2 -2 M6 10 L10 6" stroke-width=".5" fill="none" stroke="rgba(255,255,255,.55)"></path>
          </pattern>
          <marker id="arw" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0 L10 5 L0 10 z" stroke="none"></path>
          </marker>
          <marker id="tick" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="8" markerHeight="8" orient="auto">
            <path d="M2 2 L8 8 M8 2 L2 8" stroke="var(--ink)" stroke-width="1.4" fill="none"></path>
          </marker>
        </defs>

        <!-- ================= A-101 GROUND FLOOR PLAN ================= -->
        <g class="sheet live drawn" id="sheet101">
          <!-- poché fills (fade in, not drawn) -->
          <path class="fp" fill-rule="evenodd" fill="url(#poche)" stroke="none" d="M90 80 H430 V325 H90 Z M97 87 V318 H423 V87 Z"></path>
          <rect class="fp" x="105" y="233" width="100" height="3" fill="url(#poche)" stroke="none"></rect>
          <rect class="fp" x="105" y="256" width="100" height="3" fill="url(#poche)" stroke="none"></rect>
          <rect class="fp" x="105" y="279" width="100" height="3" fill="url(#poche)" stroke="none"></rect>

          <!-- heavy cut walls -->
          <rect class="dw s-h" data-p="0" x="90" y="80" width="340" height="245" style="stroke-dasharray: 1170;"></rect>
          <rect class="dw s-h" data-p="0" x="97" y="87" width="326" height="231" style="stroke-dasharray: 1114;"></rect>
          <!-- partitions (with door openings) -->
          <path class="dw s-h" data-p="0" d="M97 218 H240 M268 218 H423" style="stroke-dasharray: 298;"></path>
          <path class="dw s-h" data-p="0" d="M215 222 V318 M310 222 V288 M310 240 V222" style="stroke-dasharray: 180;"></path>
          <!-- terrace deck edge -->
          <path class="dw s-o" data-p="1" d="M430 190 H600 V325 H430" style="stroke-dasharray: 475;"></path>
          <!-- terrace slats -->
          <path class="dw s-t" data-p="2" d="M437 190 V325 M445 190 V325 M453 190 V325 M461 190 V325 M469 190 V325 M477 190 V325 M485 190 V325 M493 190 V325 M501 190 V325 M509 190 V325 M517 190 V325 M525 190 V325 M533 190 V325 M541 190 V325 M549 190 V325 M557 190 V325 M565 190 V325 M573 190 V325 M581 190 V325 M589 190 V325 M597 190 V325" style="stroke-dasharray: 2835;"></path>

          <!-- entrance door, swing -->
          <path class="dw s-o" data-p="1" d="M245 325 H267" style="stroke-dasharray: 22;"></path>
          <line class="dw s-t" data-p="2" x1="245" y1="318" x2="245" y2="292" style="stroke-dasharray: 26;"></line>
          <path class="dw s-f" data-p="2" d="M245 292 A26 26 0 0 1 271 318" fill="none" style="stroke-dasharray: 40.8466;"></path>
          <!-- vestibule → reading room door -->
          <line class="dw s-t" data-p="2" x1="268" y1="218" x2="268" y2="194" style="stroke-dasharray: 24;"></line>
          <path class="dw s-f" data-p="2" d="M268 194 A24 24 0 0 0 244 218" fill="none" style="stroke-dasharray: 37.7045;"></path>
          <!-- sliding glazing, south of reading room -->
          <path class="dw s-t" data-p="2" d="M118 321 H214 M118 323.6 H214" style="stroke-dasharray: 192;"></path>
          <rect class="dw s-o" data-p="1" x="118" y="315" width="52" height="4.5" style="stroke-dasharray: 113;"></rect>
          <rect class="dw s-o" data-p="1" x="164" y="322.5" width="52" height="4.5" style="stroke-dasharray: 113;"></rect>
          <!-- shelving (drawn) -->
          <path class="dw s-o" data-p="1" d="M105 233 H205 M105 236 H205 M105 256 H205 M105 259 H205 M105 279 H205 M105 282 H205" style="stroke-dasharray: 600;"></path>
          <!-- soapstone hearth -->
          <rect class="dw s-o" data-p="1" x="344" y="250" width="26" height="26" style="stroke-dasharray: 104;"></rect>
          <rect class="dw s-t" data-p="2" x="349" y="255" width="16" height="16" style="stroke-dasharray: 64;"></rect>
          <path class="dw s-t" data-p="2" d="M349 255 L365 271 M365 255 L349 271" style="stroke-dasharray: 45.2548;"></path>
          <line class="dw s-t" data-p="2" x1="357" y1="250" x2="357" y2="240" style="stroke-dasharray: 10;"></line>
          <!-- birch trees, dashed canopies -->
          <circle class="dw s-t s-dash2" data-p="2" cx="640" cy="118" r="34"></circle>
          <circle class="dw s-t s-dash2" data-p="2" cx="596" cy="62" r="24"></circle>
          <circle class="dw s-t s-dash2" data-p="2" cx="668" cy="198" r="28"></circle>
          <circle class="dw s-t s-dash2" data-p="2" cx="505" cy="118" r="26"></circle>
          <circle class="dw s-t s-dash2" data-p="2" cx="52" cy="150" r="30"></circle>
          <path class="dw s-t" data-p="2" d="M638 116 h4 M640 114 v4 M594 60 h4 M596 58 v4 M666 196 h4 M668 194 v4 M503 116 h4 M505 114 v4 M50 148 h4 M52 146 v4" style="stroke-dasharray: 40;"></path>
          <!-- section mark A–A' -->
          <line class="dw s-d s-dash" data-p="3" x1="262" y1="70" x2="262" y2="336" marker-start="url(#arw)" marker-end="url(#arw)"></line>
          <text class="t-label" x="252" y="63" data-full="A">A</text>
          <text class="t-label" x="252" y="348" data-full="A′">A′</text>

          <!-- dimension lines -->
          <path class="dw s-f" data-p="3" d="M90 330 V356 M430 330 V356 M600 330 V356 M84 80 H70 M84 325 H70" style="stroke-dasharray: 106;"></path>
          <line class="dw s-d" data-p="3" x1="90" y1="352" x2="430" y2="352" marker-start="url(#arw)" marker-end="url(#arw)" style="stroke-dasharray: 340;"></line>
          <line class="dw s-d" data-p="3" x1="430" y1="352" x2="600" y2="352" marker-start="url(#arw)" marker-end="url(#arw)" style="stroke-dasharray: 170;"></line>
          <line class="dw s-d" data-p="3" x1="74" y1="80" x2="74" y2="325" marker-start="url(#arw)" marker-end="url(#arw)" style="stroke-dasharray: 245;"></line>
          <text class="t-dim" x="228" y="347" data-full="14 400">14 400</text>
          <text class="t-dim" x="490" y="347" data-full="7 200">7 200</text>
          <text class="t-dim" x="66" y="207" transform="rotate(-90 66 207)" data-full="10 400">10 400</text>

          <!-- room labels + hover zones -->
          <g class="room" data-name="Reading Room" data-area="35.4">
            <rect class="roomfill" x="97" y="87" width="326" height="131"></rect>
            <text class="t-label t-faint" x="180" y="150" data-full="READING ROOM">READING ROOM</text>
          </g>
          <g class="room" data-name="Stacks" data-area="14.6">
            <rect class="roomfill" x="97" y="218" width="118" height="100"></rect>
            <text class="t-small t-faint" x="126" y="228" data-full="STACKS">STACKS</text>
          </g>
          <g class="room" data-name="Vestibule" data-area="9.8">
            <rect class="roomfill" x="215" y="218" width="95" height="100"></rect>
            <text class="t-small t-faint" x="238" y="232" data-full="VESTIBULE">VESTIBULE</text>
          </g>
          <g class="room" data-name="Hearth Alcove" data-area="11.2">
            <rect class="roomfill" x="310" y="218" width="113" height="100"></rect>
            <text class="t-small t-faint" x="326" y="232" data-full="HEARTH ALCOVE">HEARTH ALCOVE</text>
          </g>
          <g class="room" data-name="Birch Terrace" data-area="16.2">
            <rect class="roomfill" x="430" y="190" width="170" height="135"></rect>
            <text class="t-small t-faint" x="478" y="206" data-full="BIRCH TERRACE">BIRCH TERRACE</text>
          </g>

          <!-- leader callouts -->
          <path class="dw s-d" data-p="3" d="M166 317 L120 402 H84" marker-end="url(#arw)" style="stroke-dasharray: 132.649;"></path>
          <text class="t-small t-faint" x="84" y="412" data-full="SLIDING GLAZING · U 0.9 · LARICH">SLIDING GLAZING · U 0.9 · LARICH</text>
          <path class="dw s-d" data-p="3" d="M150 84 L122 52 H96" marker-end="url(#arw)" style="stroke-dasharray: 68.5206;"></path>
          <text class="t-small t-faint" x="96" y="46" data-full="CLT FRAME · 200 MINERAL WOOL">CLT FRAME · 200 MINERAL WOOL</text>
          <path class="dw s-d" data-p="3" d="M560 250 L640 300 H678" marker-end="url(#arw)" style="stroke-dasharray: 132.34;"></path>
          <text class="t-small t-faint" x="606" y="310" data-full="38 SLATS ON STEEL STRINGERS">38 SLATS ON STEEL STRINGERS</text>

          <!-- north compass -->
          <circle class="dw s-o" data-p="1" cx="742" cy="66" r="21" style="stroke-dasharray: 131.097;"></circle>
          <path class="dw s-o" data-p="1" d="M742 44 L736 70 L742 64 L748 70 Z" style="stroke-dasharray: 70.3372;"></path>
          <text class="t-label" x="738" y="101" data-full="N">N</text>

          <!-- scale bar 0-2-4 m -->
          <rect class="dw s-o" data-p="1" x="100" y="458" width="47" height="5" style="stroke-dasharray: 104;"></rect>
          <rect class="dw s-o" data-p="1" x="147" y="458" width="47" height="5" style="stroke-dasharray: 104;"></rect>
          <line class="dw s-o" data-p="1" x1="194" y1="458" x2="194" y2="463" style="stroke-dasharray: 5;"></line>
          <rect class="fp" x="100" y="458" width="47" height="5" fill="var(--ink)" stroke="none"></rect>
          <text class="t-small t-faint" x="98" y="453" data-full="0">0</text>
          <text class="t-small t-faint" x="143" y="453" data-full="2">2</text>
          <text class="t-small t-faint" x="185" y="453" data-full="4 M">4 M</text>
          <text class="t-small t-faint" x="100" y="476" data-full="SCALE 1:50 · MILLIMETRES">SCALE 1:50 · MILLIMETRES</text>

          <!-- exploded axonometric detail -->
          <text class="t-small t-faint" x="618" y="352" data-full="DETAIL 1 · WALL &amp; ROOF">DETAIL 1 · WALL &amp; ROOF</text>
          <g transform="translate(646 380)">
            <path class="dw s-o" data-p="1" d="M0 0 L44 -12 L92 -4 L48 8 Z" style="stroke-dasharray: 188.538;"></path>
            <path class="dw s-t" data-p="2" d="M0 6 L44 -6 L92 2 L48 14 Z" style="stroke-dasharray: 188.538;"></path>
            <path class="dw s-o" data-p="1" d="M4 40 L48 28 L96 36 L52 48 Z" style="stroke-dasharray: 188.538;"></path>
            <path class="dw s-t" data-p="2" d="M24 43 V52 M52 48 V57 M76 40 V49" style="stroke-dasharray: 27;"></path>
            <path class="dw s-o" data-p="1" d="M0 76 L44 64 L92 72 L48 84 Z" style="stroke-dasharray: 188.538;"></path>
            <path class="dw s-f s-dash2" data-p="2" d="M0 6 V40 M48 84 V96 M92 2 V36 M44 -12 V-24"></path>
          </g>
          <text class="t-small t-faint" x="742" y="364" data-full="ZINC / CLT">ZINC / CLT</text>
          <text class="t-small t-faint" x="742" y="410" data-full="STUD WALL">STUD WALL</text>
          <text class="t-small t-faint" x="742" y="456" data-full="SLAB">SLAB</text>
        </g>

        <!-- ================= A-201 ELEVATIONS ================= -->
        <g class="sheet" id="sheet201">
          <!-- NORTH (top-left) -->
          <line class="dw s-h" data-p="0" x1="52" y1="178" x2="356" y2="178"></line>
          <path class="dw s-f" data-p="2" d="M56 178 l-8 8 M72 178 l-8 8 M88 178 l-8 8 M104 178 l-8 8 M120 178 l-8 8 M136 178 l-8 8 M152 178 l-8 8 M168 178 l-8 8 M184 178 l-8 8 M200 178 l-8 8 M216 178 l-8 8 M232 178 l-8 8 M248 178 l-8 8 M264 178 l-8 8 M280 178 l-8 8 M296 178 l-8 8 M312 178 l-8 8 M328 178 l-8 8 M344 178 l-8 8"></path>
          <rect class="dw s-o" data-p="1" x="92" y="96" width="206" height="82"></rect>
          <line class="dw s-o" data-p="1" x1="86" y1="92" x2="304" y2="92"></line>
          <path class="dw s-t" data-p="2" d="M92 96 V178 M106 92 V178 M120 96 V178 M134 92 V178 M148 96 V178 M162 92 V178 M176 96 V178 M190 92 V178 M204 96 V178 M218 92 V178 M232 96 V178 M246 92 V178 M260 96 V178 M274 92 V178 M288 96 V178"></path>
          <rect class="dw s-o" data-p="1" x="128" y="120" width="30" height="24"></rect>
