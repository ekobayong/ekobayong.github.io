          <!-- labels -->
          <text class="t-label" x="40" y="46" data-full="A-301 · SECTION A–A · 1:50">A-301 · SECTION A–A · 1:50</text>
          <text class="t-label t-faint" x="300" y="330" data-full="READING ROOM">READING ROOM</text>
        </g>
      </svg>
      <div class="tip" id="tip" style="display: none;"></div>
    </div>

    <div class="legend" aria-label="Line weight legend">
      <span class="li"><svg width="42" height="8"><line x1="1" y1="4" x2="41" y2="4" stroke="var(--ink)" stroke-width="2.6"></line></svg>Heavy 0.35 — cut lines</span>
      <span class="li"><svg width="42" height="8"><line x1="1" y1="4" x2="41" y2="4" stroke="var(--ink)" stroke-width="1.2"></line></svg>Medium 0.25 — object lines</span>
      <span class="li"><svg width="42" height="8"><line x1="1" y1="4" x2="41" y2="4" stroke="var(--ink-soft)" stroke-width=".7"></line></svg>Thin 0.18 — detail</span>
      <span class="li"><svg width="42" height="8"><line x1="1" y1="4" x2="41" y2="4" stroke="var(--ink-soft)" stroke-width=".9" stroke-dasharray="5 4"></line></svg>Dashed — dimension / hidden</span>
    </div>

    <div class="tblock" aria-label="Title block">
      <div class="tb"><div class="k">Project</div><div class="v">Pavilion 07</div></div>
      <div class="tb"><div class="k">Client</div><div class="v">Birch Grove Trust</div></div>
      <div class="tb"><div class="k">Drawn by</div><div class="v">E. Halden</div></div>
      <div class="tb"><div class="k">Checked</div><div class="v">R. Vetri</div></div>
      <div class="tb"><div class="k">Date</div><div class="v">2026-09-04</div></div>
      <div class="tb"><div class="k">Revision</div><div class="v">C</div></div>
      <div class="tb"><div class="k">Scale</div><div class="v" id="tbScale">1:50</div></div>
      <div class="tb sheetnum"><div class="v" id="tbSheet">A-101</div></div>
    </div>
  </div></div>

<script>
(function(){
"use strict";
var reduced = !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
var sheets=[document.getElementById("sheet101"),
            document.getElementById("sheet201"),
            document.getElementById("sheet301")];
var META=[{num:"A-101",scale:"1:50"},{num:"A-201",scale:"1:100"},{num:"A-301",scale:"1:50"}];
var statDot=document.getElementById("statDot"), statTxt=document.getElementById("statTxt");
var tbSheet=document.getElementById("tbSheet"), tbScale=document.getElementById("tbScale");
var segBtns=[].slice.call(document.querySelectorAll(".seg button"));

/* remember text originals once */
sheets.forEach(function(g){
  [].slice.call(g.querySelectorAll("text")).forEach(function(tx){
    tx.dataset.full = tx.textContent;
  });
});

function estLen(el){
  try{
    if(typeof el.getTotalLength==="function"){
      var L=el.getTotalLength();
      if(L>0) return L;
    }
  }catch(e){}
  var tag=el.tagName.toLowerCase();
  try{
    if(tag==="rect"){ var w=+el.getAttribute("width"), h=+el.getAttribute("height"); return 2*(w+h); }
    if(tag==="circle"){ return 2*Math.PI*(+el.getAttribute("r")); }
    if(tag==="ellipse"){ var rx=+el.getAttribute("rx"), ry=+el.getAttribute("ry"); return 2*Math.PI*Math.sqrt((rx*rx+ry*ry)/2); }
    if(tag==="line"){ return Math.hypot(+el.getAttribute("x2")-+el.getAttribute("x1"), +el.getAttribute("y2")-+el.getAttribute("y1")); }
    if(tag==="polyline"||tag==="polygon"){
      var pts=(el.getAttribute("points")||"").trim().split(/[\s,]+/).map(Number), s=0;
      for(var i=2;i<pts.length;i+=2) s+=Math.hypot(pts[i]-pts[i-2], pts[i+1]-pts[i-1]);
      if(tag==="polygon"&&pts.length>3) s+=Math.hypot(pts[0]-pts[pts.length-2], pts[1]-pts[pts.length-1]);
      return s;
    }
  }catch(e){}
  return 100;
}

var typeToken=0;
function play(g){
  typeToken++;
  var token=typeToken;
  g.classList.remove("drawn");
  /* geometry only (rooms' tint rects & fills excluded) */
  var geos=[].slice.call(g.querySelectorAll(".dw"));
  geos.sort(function(a,b){ return (+a.dataset.p||0)-(+b.dataset.p||0); });
  var cursor=0;
  geos.forEach(function(el){
    var len=estLen(el);
    var dur=Math.min(950, Math.max(160, 90+len*0.85));
    var isDash = el.classList.contains("s-dash") || el.classList.contains("s-dash2");
    if(isDash){
      /* keep the authored dash pattern; reveal with a fade instead of a pen stroke */
      if(reduced) return;
      el.animate([{opacity:0},{opacity:1}], {duration:420, delay:cursor, easing:"linear", fill:"both"});
    }else{
      el.style.strokeDasharray=len;
      if(reduced){
        el.style.strokeDashoffset="0";
        return;
      }
      /* fade in over the first few % so arrowhead markers do not float before their line */
      el.animate(
        [{strokeDashoffset:len, opacity:0},
         {strokeDashoffset:len, opacity:1, offset:.06},
         {strokeDashoffset:0,  opacity:1}],
        {duration:dur, delay:cursor, easing:"cubic-bezier(.5,.02,.28,1)", fill:"both"}
      );
    }
    cursor += dur*0.42;            /* slight overlap — the pen never pauses */
  });
  /* text types after linework */
  var texts=[].slice.call(g.querySelectorAll("text"));
  texts.forEach(function(t){ t.textContent=""; });
  statDot.classList.remove("done");
  statTxt.textContent="Drafting";
  var lineEnd = reduced ? 0 : cursor+420;
  setTimeout(function(){
    var i=0, ci=0;
    var iv=setInterval(function(){
      if(token!==typeToken){ clearInterval(iv); return; }
      var allDone=true;
      for(i=0;i<texts.length;i++){
        var t=texts[i], full=t.dataset.full;
        var shown=t.textContent.length;
        if(shown<full.length){
          t.textContent=full.slice(0, Math.min(full.length, shown+2));
          if(t.textContent.length<full.length) allDone=false;
        }
      }
      if(allDone){
        clearInterval(iv);
        g.classList.add("drawn");
        statDot.classList.add("done");
        statTxt.textContent="Sheet complete";
      }
    }, reduced?1:26);
    if(reduced){
      clearInterval(iv);
      texts.forEach(function(t){ t.textContent=t.dataset.full; });
      g.classList.add("drawn");
      statDot.classList.add("done");
      statTxt.textContent="Sheet complete";
    }
  }, lineEnd);
}

function show(i){
  sheets.forEach(function(s,k){ s.classList.toggle("live", k===i); });
  segBtns.forEach(function(b,k){ b.setAttribute("aria-pressed", k===i?"true":"false"); });
  tbSheet.textContent=META[i].num;
  tbScale.textContent=META[i].scale;
  hideTip(); unpin();
  play(sheets[i]);
}
segBtns.forEach(function(b,i){ b.addEventListener("click", function(){ show(i); }); });

/* ---------- rooms: hover tint + tooltip + pin ---------- */
var stage=document.getElementById("stage"), tip=document.getElementById("tip");
var pinned=null;
function hideTip(){ tip.style.display="none"; }
function unpin(){ if(pinned){ pinned.classList.remove("pinned"); pinned=null; } }
[].slice.call(document.querySelectorAll("#sheet101 .room")).forEach(function(room){
  var hit=room.querySelector(".roomfill");
  hit.addEventListener("pointermove", function(e){
    var r=stage.getBoundingClientRect();
    tip.innerHTML='<span class="nm">'+room.dataset.name+'</span><span class="ar">'+room.dataset.area+' m²</span>';
    tip.style.display="block";
    tip.style.left=Math.max(60, Math.min(r.width-60, e.clientX-r.left))+"px";
    tip.style.top=(e.clientY-r.top)+"px";
  });
  hit.addEventListener("pointerleave", hideTip);
  hit.addEventListener("click", function(e){
    if(pinned===room){ unpin(); return; }
    unpin(); pinned=room; room.classList.add("pinned");
    e.stopPropagation();
  });
});

/* ---------- print mode + shortcuts ---------- */
var printBtn=document.getElementById("printBtn");
function togglePrint(){
  var on=document.body.classList.toggle("print");
  printBtn.setAttribute("aria-pressed", on?"true":"false");
}
printBtn.addEventListener("click", togglePrint);
document.addEventListener("keydown", function(e){
  if(e.metaKey||e.ctrlKey||e.altKey) return;
  if(e.key==="1") show(0);
  else if(e.key==="2") show(1);
  else if(e.key==="3") show(2);
  else if(e.key==="p"||e.key==="P") togglePrint();
});

/* first draw */
show(0);
})();
</script>


</body></html>
