        </g>

        <!-- ================= A-301 SECTION ================= -->
        <g class="sheet" id="sheet301">
          <!-- ground + hatch -->
          <line class="dw s-h" data-p="0" x1="40" y1="400" x2="760" y2="400"></line>
          <path class="dw s-f" data-p="2" d="M48 400 l-8 8 M66 400 l-8 8 M84 400 l-8 8 M102 400 l-8 8 M120 400 l-8 8 M138 400 l-8 8 M156 400 l-8 8 M174 400 l-8 8 M192 400 l-8 8 M210 400 l-8 8 M228 400 l-8 8 M246 400 l-8 8 M264 400 l-8 8 M282 400 l-8 8 M300 400 l-8 8 M318 400 l-8 8 M336 400 l-8 8 M354 400 l-8 8 M372 400 l-8 8 M390 400 l-8 8 M408 400 l-8 8 M426 400 l-8 8 M444 400 l-8 8 M462 400 l-8 8 M480 400 l-8 8 M498 400 l-8 8 M516 400 l-8 8 M534 400 l-8 8 M552 400 l-8 8 M570 400 l-8 8 M588 400 l-8 8 M606 400 l-8 8 M624 400 l-8 8 M642 400 l-8 8 M660 400 l-8 8 M678 400 l-8 8 M696 400 l-8 8 M714 400 l-8 8 M732 400 l-8 8 M750 400 l-8 8"></path>
          <!-- poché fills -->
