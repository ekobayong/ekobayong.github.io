          <path class="dw s-o" data-p="1" d="M452 388 V366 H438 M452 366 V352 M444 388 V372"></path>
          <!-- stick-figure scale person -->
          <circle class="dw s-o" data-p="1" cx="492" cy="318" r="6.5"></circle>
          <path class="dw s-o" data-p="1" d="M492 324.5 V362 M492 332 L480 348 M492 332 L504 346 M492 362 L482 392 M492 362 L502 392"></path>
          <!-- level markers -->
