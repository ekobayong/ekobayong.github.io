          <polygon class="dw s-d" data-p="3" points="648,392 654,384 660,392" fill="none"></polygon>
          <polygon class="dw s-d" data-p="3" points="654,296 660,288 666,296" fill="none"></polygon>
          <polygon class="dw s-d" data-p="3" points="654,254 660,246 666,254" fill="none"></polygon>
          <text class="t-small" x="668" y="388" data-full="±0.00">±0.00</text>
          <text class="t-small" x="668" y="292" data-full="+3.60">+3.60</text>
          <text class="t-small" x="668" y="250" data-full="+4.20">+4.20</text>
          <!-- material callouts -->
          <path class="dw s-d" data-p="3" d="M300 268 L258 226 H210" marker-end="url(#arw)"></path>
          <text class="t-small t-faint" x="160" y="222" data-full="40 MM CLT, EXPOSED">40 MM CLT, EXPOSED</text>
          <path class="dw s-d" data-p="3" d="M60 260 L148 274" marker-end="url(#arw)"></path>
          <text class="t-small t-faint" x="40" y="254" data-full="200 MINERAL WOOL">200 MINERAL WOOL</text>
          <path class="dw s-d" data-p="3" d="M300 448 L244 412" marker-end="url(#arw)"></path>
          <text class="t-small t-faint" x="240" y="458" data-full="SLAB ON 120 EPS">SLAB ON 120 EPS</text>
