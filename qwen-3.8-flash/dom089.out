<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MS-2 Duet — Mini Analog-Style Synthesizer</title>
<style>
  :root{ --ink:#2b2d31; }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ overflow-x:hidden; }
  body{
    background:radial-gradient(120% 95% at 50% 10%, #2a2523 0%, #1f1b19 45%, #141312 100%);
    background-attachment:fixed;
    color:#c9c4bd;
    font-family:Arial, Helvetica, sans-serif;
    min-height:100vh;
    padding:26px 10px 46px;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  .mono{ font-family:ui-monospace, "Cascadia Mono", Consolas, Menlo, monospace; }

  /* ---------- intro ---------- */
  .intro{ max-width:1080px; margin:0 auto 14px; }
  .intro h1{ font:400 15px/1.45 Georgia, "Iowan Old Style", serif; color:#b9986a; letter-spacing:.1em; }
  .intro p{ font-size:10.5px; line-height:1.6; color:#7b756c; letter-spacing:.04em; margin-top:3px; }
  .intro p b{ color:#8fca9c; font-weight:400; }

  /* ---------- panel ---------- */
  .rig{
    max-width:1080px; margin:18px auto 0;
    display:grid; grid-template-columns:20px 1fr 20px;
    filter:drop-shadow(0 18px 38px rgba(0,0,0,.62));
  }
  .cheek{
    border-radius:6px 0 0 6px;
    background:
      repeating-linear-gradient(118deg,
        rgba(18,7,2,.28) 0 2px, rgba(255,196,128,.06) 3px 5px,
        rgba(70,34,12,.20) 6px 10px, transparent 11px 22px),
      linear-gradient(90deg, #3a2216 0%, #59341f 34%, #6b3f28 58%, #8a5535 80%, #5a331e 100%);
    box-shadow:inset 0 0 10px rgba(0,0,0,.6), inset 1px 0 0 rgba(255,205,150,.18);
  }
  .cheek.right{ border-radius:0 6px 6px 0;
    background:
      repeating-linear-gradient(118deg,
        rgba(18,7,2,.28) 0 2px, rgba(255,196,128,.06) 3px 5px,
        rgba(70,34,12,.20) 6px 10px, transparent 11px 22px),
      linear-gradient(270deg, #3a2216 0%, #59341f 34%, #6b3f28 58%, #8a5535 80%, #5a331e 100%);
    box-shadow:inset 0 0 10px rgba(0,0,0,.6), inset -1px 0 0 rgba(255,205,150,.18);
  }
  .panel{
    position:relative; padding:14px 16px 16px;
    background:
      repeating-linear-gradient(90deg, rgba(255,255,255,.055) 0 1px, transparent 1px 2px),
      repeating-linear-gradient(90deg, rgba(0,0,0,.05) 0 1px, transparent 1px 4px),
      linear-gradient(180deg, #d9dadb 0%, #cfd1d3 34%, #b9bbbe 55%, #a9acb0 78%, #9ea1a5 100%);
  }
  .screw{
    position:absolute; width:13px; height:13px; border-radius:50%; z-index:4;
    background:
      linear-gradient(0deg, transparent 43%, rgba(28,28,30,.9) 43% 57%, transparent 57%),
      radial-gradient(circle at 34% 30%, #dcdcde 0%, #a3a5a8 42%, #6a6c71 80%, #4a4c50 100%);
    box-shadow:0 1px 2px rgba(0,0,0,.5), inset 0 -1px 1px rgba(0,0,0,.35);
  }
  .screw.tl{ top:7px; left:8px; } .screw.tr{ top:7px; right:8px; transform:rotate(24deg); }
  .screw.bl{ bottom:7px; left:8px; transform:rotate(-41deg); } .screw.br{ bottom:7px; right:8px; transform:rotate(63deg); }

  .panel-top{
    display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap;
    padding:0 8px 10px; margin-bottom:12px;
    border-bottom:1px solid rgba(43,45,49,.16);
  }
  .brand{ font:700 10px/1 Arial; letter-spacing:.26em; color:var(--ink); text-transform:uppercase; }
  .brand small{ font-weight:400; font-size:9px; letter-spacing:.18em; color:#55575d; }
  .status-wrap{ display:flex; align-items:center; gap:8px; }
  #statusText{ font-size:9.5px; letter-spacing:.22em; color:#55575d; text-transform:uppercase; }
  .led-cap{ font:700 8px/1 Arial; letter-spacing:.2em; color:#55575d; }
  .led{ width:8px; height:8px; border-radius:50%; background:#5a5a5e;
    box-shadow:inset 0 1px 1px rgba(0,0,0,.65), 0 0 0 1px rgba(43,45,49,.25);
    transition:background .15s, box-shadow .25s; }
  .led.power.on{ background:radial-gradient(circle at 40% 34%, #ff9182 0%, #e02714 55%, #78100a 100%);
    box-shadow:0 0 8px 1px rgba(255,64,32,.75), inset 0 1px 1px rgba(255,255,255,.35); }
  .led.signal.on{ background:radial-gradient(circle at 40% 34%, #b8ffcf 0%, #1cc450 55%, #0a5c26 100%);
    box-shadow:0 0 8px 1px rgba(46,255,120,.7), inset 0 1px 1px rgba(255,255,255,.35); }

  /* ---------- module grid ---------- */
  .grid{ display:grid; grid-template-columns:repeat(12, 1fr); gap:14px; }
  .module{
    grid-column:span 3;
    position:relative;
    border:1px solid rgba(43,45,49,.30);
    border-radius:8px;
    padding:15px 8px 10px;
    display:flex; flex-direction:column; align-items:center; gap:8px;
    background:linear-gradient(180deg, rgba(255,255,255,.08), rgba(0,0,0,.05));
  }
  .module.s4{ grid-column:span 4; } .module.s6{ grid-column:span 6; } .module.s2{ grid-column:span 2; }
  .mod-title{
    position:absolute; top:-6px; left:11px; padding:0 6px;
    background:linear-gradient(180deg,#d3d5d6,#bfc1c4);
    font:700 9px/12px Arial; letter-spacing:.24em; color:var(--ink); text-transform:uppercase;
  }
  .knob-row{ display:flex; justify-content:space-evenly; gap:4px; width:100%; flex-wrap:wrap; }
  .sw-group{ display:flex; gap:5px; }
  .sw-label{ font:700 8.5px/1 Arial; letter-spacing:.22em; color:#55575d; margin-top:2px; }

  /* ---------- knobs ---------- */
  .knob-cell{ display:flex; flex-direction:column; align-items:center; gap:4px; padding:2px 3px; }
  .k-label{ font:700 9px/1 Arial; letter-spacing:.18em; color:var(--ink); text-transform:uppercase; }
  .knob{
    width:40px; height:40px; border-radius:50%; position:relative; cursor:ns-resize; outline:none;
    background:
      repeating-conic-gradient(from 0deg, rgba(255,255,255,.10) 0deg 4deg, rgba(0,0,0,.16) 4deg 9deg),
      radial-gradient(circle at 38% 30%, #4a4d53 0%, #36383e 42%, #1f2125 100%);
    box-shadow:
      0 4px 8px rgba(0,0,0,.5),
      0 0 0 1px rgba(10,10,12,.7),
      0 0 0 4px rgba(255,255,255,.05),
      inset 0 -3px 5px rgba(0,0,0,.55),
      inset 0 2px 3px rgba(255,255,255,.10);
    touch-action:none;
    transform:rotate(-135deg);
  }
  .knob::before{ /* pointer */
    content:""; position:absolute; left:50%; top:4px; width:2px; height:12px; margin-left:-1px;
    background:#f4f5f7; border-radius:1px; box-shadow:0 0 3px rgba(255,255,255,.7);
  }
  .knob:focus-visible{ box-shadow:0 4px 8px rgba(0,0,0,.5), 0 0 0 2px #2e7d5b, 0 0 9px rgba(125,255,176,.55); }
  .k-val{ font-size:9px; line-height:1.15; color:#3a3d43; letter-spacing:.05em; min-height:11px; }

  /* ---------- rubber buttons ---------- */
  .rbtn{
    appearance:none; -webkit-appearance:none; font-family:inherit; cursor:pointer; user-select:none;
    display:inline-flex; align-items:center; justify-content:center; gap:6px;
    background:linear-gradient(180deg, #565961 0%, #3c3f45 52%, #2b2d33 100%);
    color:#dcdde0; border:1px solid #1c1e22; border-radius:5px;
    box-shadow:0 3px 0 #131418, inset 0 1px 0 rgba(255,255,255,.14);
    font:700 9px/1 Arial; letter-spacing:.18em; text-transform:uppercase;
    padding:9px 12px;
    transition:transform .06s, box-shadow .06s, color .12s;
  }
  .rbtn:hover{ color:#fff; }
  .rbtn[aria-pressed="true"]{
    transform:translateY(2px);
    box-shadow:0 1px 0 #131418, inset 0 2px 5px rgba(0,0,0,.6);
    color:#ffe0a3;
  }
  .rbtn.mini{ padding:7px 9px; font-size:8.5px; letter-spacing:.16em; }
  .wave-btn{ width:100%; height:32px; padding:0; }
  .wave-btn svg{ display:block; }
  .wave-btn[aria-pressed="true"]{ color:#7dffb0; }
  .mini-led{ width:7px; height:7px; border-radius:50%; background:#4d3a12; box-shadow:inset 0 1px 1px rgba(0,0,0,.6); flex:none; }
  .rbtn[aria-pressed="true"] .mini-led{
    background:radial-gradient(circle at 40% 34%, #ffdda0, #ff9d1c 58%, #7c4b06);
    box-shadow:0 0 6px 1px rgba(255,160,32,.85);
  }

  /* ---------- screens ---------- */
  .screen{
    position:relative; width:calc(100% - 14px); border-radius:5px; overflow:hidden;
    box-shadow:inset 0 0 0 1px rgba(43,45,49,.45), inset 0 2px 7px rgba(0,0,0,.7), 0 1px 0 rgba(255,255,255,.35);
  }
  .screen canvas{ display:block; width:100%; height:100%; }
  .screen::after{ /* CSS scanlines */
    content:""; position:absolute; inset:0; pointer-events:none;
    background:repeating-linear-gradient(0deg, transparent 0 2px, rgba(0,0,0,.16) 2px 3px);
  }
  .scr-env{ height:82px; background:#08150d; }
  .scr-filter{ height:82px; background:#06110b; }
  .scr-scope{ height:126px; background:#06110b; }
  .scr-note{ font-size:8.5px; letter-spacing:.14em; color:#5a5c62; text-transform:uppercase; }

  /* ---------- arp ---------- */
  .arp-top{ display:flex; align-items:center; gap:8px; width:100%; justify-content:center; flex-wrap:wrap; }
  .step-leds{ display:flex; gap:9px; margin-top:2px; }
  .step-leds i{
    width:9px; height:9px; border-radius:50%; background:#4d3a12;
    box-shadow:inset 0 1px 1px rgba(0,0,0,.65), 0 0 0 1px rgba(43,45,49,.25);
    transition:background .06s, box-shadow .14s;
  }
  .step-leds i.on{
    background:radial-gradient(circle at 38% 32%, #ffe2a6, #ff9d1c 58%, #8a5206);
    box-shadow:0 0 9px 2px rgba(255,160,30,.85), inset 0 1px 1px rgba(255,255,255,.3);
  }
  .divider{ width:78%; height:1px; background:rgba(43,45,49,.18); margin:2px 0; }

  /* ---------- keyboard ---------- */
  .kb-tray{
    margin-top:16px; border-radius:8px; padding:10px 10px 12px;
    background:linear-gradient(180deg, #2d2e33 0%, #212226 55%, #121316 100%);
    box-shadow:inset 0 2px 7px rgba(0,0,0,.85), inset 0 -1px 0 rgba(255,255,255,.05), 0 1px 0 rgba(255,255,255,.30);
    touch-action:none;
  }
  .keys{ position:relative; display:flex; height:140px; }
  .key{ -webkit-tap-highlight-color:transparent; user-select:none; cursor:pointer; }
  .key.w{
    position:relative; flex:1 1 0; min-width:0; z-index:1;
    display:flex; flex-direction:column; align-items:center; justify-content:flex-end; gap:3px; padding-bottom:7px;
    background:linear-gradient(180deg, #f4efe1 0%, #efe9d9 62%, #e3dcca 88%, #d5cdb8 100%);
    border:1px solid #6f6a5c; border-radius:0 0 4px 4px;
    box-shadow:inset 0 -6px 5px -4px rgba(93,80,50,.4), inset 0 1px 0 #fffdf4, 0 2px 3px rgba(0,0,0,.4);
    transition:background .07s, transform .07s, box-shadow .07s;
  }
  .key.w .legend{ font-size:9px; font-weight:700; color:#9b9483; letter-spacing:.05em; }
  .key.w .note{ font:400 8.5px/1 Arial; color:#b4ac98; letter-spacing:.06em; }
  .key.b{
    position:absolute; top:0; height:60%; z-index:2;
    display:flex; flex-direction:column; align-items:center; justify-content:flex-end; gap:3px; padding-bottom:5px;
    background:linear-gradient(180deg, #45474d 0%, #26282c 48%, #101114 100%);
    border:1px solid #050506; border-radius:0 0 3px 3px;
    box-shadow:0 5px 6px rgba(0,0,0,.65), inset 0 1px 0 rgba(255,255,255,.15);
    transition:background .07s, transform .07s, box-shadow .07s;
  }
  .key.b .legend{ font-size:8.5px; font-weight:700; color:#8b8f98; }
  .key.w.on{
    background:linear-gradient(180deg, #ffe0a3 0%, #ffc766 100%);
    transform:translateY(2px);
    box-shadow:0 0 14px rgba(255,183,86,.6), inset 0 -3px 4px -2px rgba(150,80,0,.45);
  }
  .key.w.on .legend{ color:#8a5a12; } .key.w.on .note{ color:#a3742c; }
  .key.b.on{
    background:linear-gradient(180deg, #ff9a3b 0%, #c76a12 100%);
    transform:translateY(2px);
    box-shadow:0 0 16px rgba(255,146,52,.75), inset 0 1px 0 rgba(255,255,255,.3);
  }
  .key.b.on .legend{ color:#fff1d6; }

  .panel-bottom{
    margin-top:14px; display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; padding:0 6px;
  }
  .oc-wrap{ display:flex; align-items:center; gap:8px; }
  .readout{
    font-size:12px; letter-spacing:.14em; color:#22242a; text-transform:uppercase;
    background:linear-gradient(180deg, #edf0e9 0%, #d8dbd3 100%);
    border:1px solid rgba(43,45,49,.42); border-radius:4px; padding:6px 10px; min-width:74px; text-align:center;
    box-shadow:inset 0 2px 4px rgba(0,0,0,.22);
  }
  .model{ font:700 8.5px/1 Arial; letter-spacing:.26em; color:rgba(43,45,49,.62); text-transform:uppercase; }
  .serial{ font-size:8.5px; letter-spacing:.1em; color:rgba(43,45,49,.55); }

  /* ---------- responsive ---------- */
  @media (max-width:900px){
    .module, .module.s4, .module.s6{ grid-column:span 6; }
    .module.s2{ grid-column:span 6; }
    .keys{ height:118px; }
  }
  @media (max-width:600px){
    .module, .module.s4, .module.s6, .module.s2{ grid-column:span 12; }
    .rig{ grid-template-columns:10px 1fr 10px; }
    .panel{ padding:12px 8px 12px; }
    .keys{ height:96px; }
    .key.w .note{ display:none; }
    .key.w .legend, .key.b .legend{ font-size:7px; }
    .key.b{ width:3.5% !important; }
  }
  @media (prefers-reduced-motion: reduce){
    *{ transition:none !important; }
  }
</style>
</head>
<body>
  <header class="intro">
    <h1>MS-2 Duet — two-octave mono/poly synthesizer</h1>
    <p class="mono">// all sound is synthesized in-browser with the Web Audio API — no samples, no audio files.
      <b>it stays silent until you touch it.</b> play with Z S X D C V … or click and drag across the keys.</p>
  </header>

  <main class="rig">
    <div class="cheek" aria-hidden="true"></div>
    <section class="panel" aria-label="MS-2 Duet synthesizer">
      <i class="screw tl" aria-hidden="true"></i><i class="screw tr" aria-hidden="true"></i>
      <i class="screw bl" aria-hidden="true"></i><i class="screw br" aria-hidden="true"></i>

      <div class="panel-top">
        <div class="brand">MS-2 Duet <small>· analog-modelling synthesizer</small></div>
        <div class="status-wrap">
          <span id="statusText" class="mono">standby</span>
          <span class="led-cap">POWER</span><i class="led power" id="powerLed" aria-hidden="true"></i>
        </div>
      </div>

      <div class="grid">
        <!-- OSCILLATOR -->
        <section class="module">
          <h2 class="mod-title">Oscillator</h2>
          <div class="knob-row" style="display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:0 6px;">
            <button class="rbtn wave-btn" data-wave="sine" aria-pressed="false" aria-label="Sine wave">
              <svg width="22" height="14" viewBox="0 0 22 14"><path d="M1 12 C 4 1, 7 1, 11 7 S 18 13, 21 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
            </button>
            <button class="rbtn wave-btn" data-wave="triangle" aria-pressed="false" aria-label="Triangle wave">
              <svg width="22" height="14" viewBox="0 0 22 14"><path d="M1 12 L 6 2 L 11 12 L 16 2 L 21 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>
            </button>
            <button class="rbtn wave-btn" data-wave="sawtooth" aria-pressed="false" aria-label="Sawtooth wave">
              <svg width="22" height="14" viewBox="0 0 22 14"><path d="M1 12 L 7 2 L 7 12 L 13 2 L 13 12 L 19 2 L 19 12 L 21 10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>
            </button>
            <button class="rbtn wave-btn" data-wave="square" aria-pressed="true" aria-label="Square wave">
              <svg width="22" height="14" viewBox="0 0 22 14"><path d="M1 12 L 1 2 L 7 2 L 7 12 L 13 12 L 13 2 L 19 2 L 19 12 L 21 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>
            </button>
          </div>
          <div class="divider"></div>
          <div class="knob-row" id="knobs-osc"><div class="knob-cell"><div class="k-label">Detune</div><div class="knob" tabindex="0" role="slider" aria-label="Detune" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-valuetext="0 ¢" style="transform: rotate(0deg);"></div><div class="k-val mono">0 ¢</div></div><div class="knob-cell"><div class="k-label">Glide</div><div class="knob" tabindex="0" role="slider" aria-label="Glide" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="0 ms" style="transform: rotate(-135deg);"></div><div class="k-val mono">0 ms</div></div></div>
        </section>

        <!-- ENVELOPE -->
        <section class="module">
          <h2 class="mod-title">Envelope</h2>
          <div class="knob-row" id="knobs-env"><div class="knob-cell"><div class="k-label">Attack</div><div class="knob" tabindex="0" role="slider" aria-label="Attack" aria-valuemin="0" aria-valuemax="100" aria-valuenow="8" aria-valuetext="12 ms" style="transform: rotate(-112.94deg);"></div><div class="k-val mono">12 ms</div></div><div class="knob-cell"><div class="k-label">Decay</div><div class="knob" tabindex="0" role="slider" aria-label="Decay" aria-valuemin="0" aria-valuemax="100" aria-valuenow="28" aria-valuetext="220 ms" style="transform: rotate(-58.3252deg);"></div><div class="k-val mono">220 ms</div></div><div class="knob-cell"><div class="k-label">Sustain</div><div class="knob" tabindex="0" role="slider" aria-label="Sustain" aria-valuemin="0" aria-valuemax="100" aria-valuenow="60" aria-valuetext="60 %" style="transform: rotate(27deg);"></div><div class="k-val mono">60 %</div></div><div class="knob-cell"><div class="k-label">Release</div><div class="knob" tabindex="0" role="slider" aria-label="Release" aria-valuemin="0" aria-valuemax="100" aria-valuenow="28" aria-valuetext="340 ms" style="transform: rotate(-60.6849deg);"></div><div class="k-val mono">340 ms</div></div></div>
          <div class="screen scr-env"><canvas id="envCanvas" aria-hidden="true" width="289" height="82"></canvas></div>
          <div class="scr-note mono">adsr · phosphor</div>
        </section>

        <!-- LOW-PASS FILTER -->
        <section class="module">
          <h2 class="mod-title">Low-pass Filter</h2>
          <div class="knob-row" id="knobs-flt"><div class="knob-cell"><div class="k-label">Cutoff</div><div class="knob" tabindex="0" role="slider" aria-label="Cutoff" aria-valuemin="0" aria-valuemax="100" aria-valuenow="42" aria-valuetext="1.24 kHz" style="transform: rotate(-21.6deg);"></div><div class="k-val mono">1.24 kHz</div></div><div class="knob-cell"><div class="k-label">Resonance</div><div class="knob" tabindex="0" role="slider" aria-label="Resonance" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="0.0 dB" style="transform: rotate(-135deg);"></div><div class="k-val mono">0.0 dB</div></div></div>
          <div class="screen scr-filter"><canvas id="fltCanvas" aria-hidden="true" width="289" height="82"></canvas></div>
          <div class="scr-note mono">rbj biquad · 20 Hz – 20 kHz</div>
        </section>

        <!-- LFO -->
        <section class="module">
          <h2 class="mod-title">LFO</h2>
          <div class="knob-row" id="knobs-lfo"><div class="knob-cell"><div class="k-label">Rate</div><div class="knob" tabindex="0" role="slider" aria-label="Rate" aria-valuemin="0" aria-valuemax="100" aria-valuenow="7" aria-valuetext="0.12 Hz" style="transform: rotate(-115.874deg);"></div><div class="k-val mono">0.12 Hz</div></div><div class="knob-cell"><div class="k-label">Depth</div><div class="knob" tabindex="0" role="slider" aria-label="Depth" aria-valuemin="0" aria-valuemax="100" aria-valuenow="30" aria-valuetext="30 %" style="transform: rotate(-54deg);"></div><div class="k-val mono">30 %</div></div></div>
          <div class="sw-group" role="group" aria-label="LFO target">
            <button class="rbtn mini" data-lfo-target="pitch" aria-pressed="true">Pitch</button>
            <button class="rbtn mini" data-lfo-target="filter" aria-pressed="false">Filter</button>
          </div>
          <span class="sw-label">target</span>
          <div class="sw-group" role="group" aria-label="LFO shape">
            <button class="rbtn mini" data-lfo-shape="sine" aria-pressed="true">Sin</button>
            <button class="rbtn mini" data-lfo-shape="triangle" aria-pressed="false">Tri</button>
            <button class="rbtn mini" data-lfo-shape="square" aria-pressed="false">Sqr</button>
          </div>
          <span class="sw-label">shape</span>
        </section>

        <!-- SCOPE -->
        <section class="module s6">
          <h2 class="mod-title">Scope</h2>
          <div class="screen scr-scope"><canvas id="scopeCanvas" aria-hidden="true" width="289" height="126"></canvas></div>
          <div class="scr-note mono">oscilloscope · time domain · fft 2048</div>
        </section>

        <!-- ARPEGGIATOR -->
        <section class="module s4">
          <h2 class="mod-title">Arpeggiator</h2>
          <div class="arp-top">
            <button class="rbtn" id="arpBtn" aria-pressed="false"><i class="mini-led" aria-hidden="true"></i>Arp</button>
            <div class="sw-group" role="group" aria-label="Arpeggio pattern">
              <button class="rbtn mini" data-arp="up" aria-pressed="true">Up</button>
              <button class="rbtn mini" data-arp="down" aria-pressed="false">Down</button>
              <button class="rbtn mini" data-arp="rnd" aria-pressed="false">Rnd</button>
            </div>
          </div>
          <div class="knob-row" id="knobs-arp"><div class="knob-cell"><div class="k-label">Tempo</div><div class="knob" tabindex="0" role="slider" aria-label="Tempo" aria-valuemin="0" aria-valuemax="100" aria-valuenow="40" aria-valuetext="120 bpm" style="transform: rotate(-27deg);"></div><div class="k-val mono">120 bpm</div></div><div class="knob-cell"><div class="k-label">Gate</div><div class="knob" tabindex="0" role="slider" aria-label="Gate" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-valuetext="50 %" style="transform: rotate(0deg);"></div><div class="k-val mono">50 %</div></div></div>
          <div class="step-leds" id="stepLeds" aria-label="Arpeggio step indicators">
            <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
          </div>
        </section>

        <!-- MASTER -->
        <section class="module s2">
          <h2 class="mod-title">Master</h2>
          <div class="knob-row" id="knobs-mst"><div class="knob-cell"><div class="k-label">Volume</div><div class="knob" tabindex="0" role="slider" aria-label="Volume" aria-valuemin="0" aria-valuemax="100" aria-valuenow="80" aria-valuetext="80 %" style="transform: rotate(81deg);"></div><div class="k-val mono">80 %</div></div></div>
          <div style="display:flex;align-items:center;gap:7px;margin-top:4px">
            <i class="led signal" id="sigLed" aria-hidden="true"></i>
            <span class="sw-label">signal</span>
          </div>
        </section>
      </div>

      <!-- keyboard -->
      <div class="kb-tray" id="kbTray" aria-label="Two-octave keyboard, C3 to C5">
        <div class="keys" id="keys"><div class="key w" data-semi="0"><span class="legend mono">Z</span><span class="note">C3</span></div><div class="key w" data-semi="2"><span class="legend mono">X</span><span class="note">D3</span></div><div class="key w" data-semi="4"><span class="legend mono">C</span><span class="note">E3</span></div><div class="key w" data-semi="5"><span class="legend mono">V</span><span class="note">F3</span></div><div class="key w" data-semi="7"><span class="legend mono">B</span><span class="note">G3</span></div><div class="key w" data-semi="9"><span class="legend mono">N</span><span class="note">A3</span></div><div class="key w" data-semi="11"><span class="legend mono">M</span><span class="note">B3</span></div><div class="key w" data-semi="12"><span class="legend mono">Q</span><span class="note">C4</span></div><div class="key w" data-semi="14"><span class="legend mono">W</span><span class="note">D4</span></div><div class="key w" data-semi="16"><span class="legend mono">E</span><span class="note">E4</span></div><div class="key w" data-semi="17"><span class="legend mono">R</span><span class="note">F4</span></div><div class="key w" data-semi="19"><span class="legend mono">T</span><span class="note">G4</span></div><div class="key w" data-semi="21"><span class="legend mono">Y</span><span class="note">A4</span></div><div class="key w" data-semi="23"><span class="legend mono">U</span><span class="note">B4</span></div><div class="key w" data-semi="24"><span class="legend mono">I</span><span class="note">C5</span></div><div class="key b" data-semi="1" style="width: 4.13333%; left: calc(7.93333%);"><span class="legend mono">S</span></div><div class="key b" data-semi="3" style="width: 4.13333%; left: calc(14.6%);"><span class="legend mono">D</span></div><div class="key b" data-semi="6" style="width: 4.13333%; left: calc(27.9333%);"><span class="legend mono">G</span></div><div class="key b" data-semi="8" style="width: 4.13333%; left: calc(34.6%);"><span class="legend mono">H</span></div><div class="key b" data-semi="10" style="width: 4.13333%; left: calc(41.2667%);"><span class="legend mono">J</span></div><div class="key b" data-semi="13" style="width: 4.13333%; left: calc(54.6%);"><span class="legend mono">2</span></div><div class="key b" data-semi="15" style="width: 4.13333%; left: calc(61.2667%);"><span class="legend mono">3</span></div><div class="key b" data-semi="18" style="width: 4.13333%; left: calc(74.6%);"><span class="legend mono">5</span></div><div class="key b" data-semi="20" style="width: 4.13333%; left: calc(81.2667%);"><span class="legend mono">6</span></div><div class="key b" data-semi="22" style="width: 4.13333%; left: calc(87.9333%);"><span class="legend mono">7</span></div></div>
      </div>

      <div class="panel-bottom">
        <div class="oc-wrap">
          <button class="rbtn mini" id="octDown" aria-label="Octave down">−</button>
          <button class="rbtn mini" id="octUp" aria-label="Octave up">+</button>
          <div class="readout mono" id="octReadout" aria-live="polite">oct ±0 · C3–C5</div>
        </div>
        <div>
          <span class="model">Model MS-2D&nbsp;·&nbsp;browser instrument</span>
          <span class="serial mono">&nbsp;sn 0042·duo·rev C</span>
        </div>
      </div>
    </section>
    <div class="cheek right" aria-hidden="true"></div>
  </main>

<script>
(function(){
"use strict";
var clamp=function(v,a,b){ return v<a?a:(v>b?b:v); };
var NAMES=["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"];
function noteName(m){ return NAMES[((m%12)+12)%12] + (Math.floor(m/12)-1); }
function mtof(m){ return 440*Math.pow(2,(m-69)/12); }

/* =========================================================
   STATE
   ========================================================= */
var S={
  wave:"square", detune:0, glide:0,
  attack:12, decay:220, sustain:.6, release:340,
  cutoff:.42, reso:0,
  lfoRate:.12, lfoDepth:.3, lfoTarget:"pitch", lfoShape:"sine",
  arp:false, arpPattern:"up", tempo:120, gate:.5,
  volume:.8, octave:0
};
/* parameter mappings */
function cutoffHz(){ var t=S.cutoff; return 60 + (16000-60)*t*t*t; }           /* cubic taper */
function biquadQ(){ return Math.pow(10, S.reso/20); }                          /* dB → Q */

/* =========================================================
   AUDIO ENGINE
   ========================================================= */
var AC=null, master=null, lp=null, analyser=null, scopeBuf=null,
    lfo=null, lfoPitch=null, lfoFilt=null;
var powered=false;
var lastMidi=null;
var sigLedEl=null;

function ensurePower(){
  if(powered) return true;
  var Ctor=window.AudioContext||window.webkitAudioContext;
  if(!Ctor) return false;
  powered=true;
  AC=new Ctor();
  master=AC.createGain();  master.gain.value=S.volume;
  lp=AC.createBiquadFilter(); lp.type="lowpass";
  lp.frequency.value=cutoffHz(); lp.Q.value=biquadQ();
  analyser=AC.createAnalyser(); analyser.fftSize=2048; analyser.smoothingTimeConstant=0;
  scopeBuf=new Float32Array(analyser.fftSize);
  lp.connect(master); master.connect(analyser); analyser.connect(AC.destination);

  /* LFO: always running, feeds two gain nodes */
  lfo=AC.createOscillator();
  lfo.type=S.lfoShape;
  lfo.frequency.value=S.lfoRate;
  lfoPitch=AC.createGain(); lfoFilt=AC.createGain();
  applyLfoGains();
  lfo.connect(lfoPitch); lfo.connect(lfoFilt);
  lfo.start();

  document.getElementById("powerLed").classList.add("on");
  document.getElementById("statusText").textContent="power on";
  return true;
}
function applyLfoGains(){
  if(!lfo) return;
  /* switching target zeroes the other */
  lfoPitch.gain.setTargetAtTime(S.lfoTarget==="pitch" ? S.lfoDepth*120 : 0, AC.currentTime, .02);
  lfoFilt.gain.setTargetAtTime(S.lfoTarget==="filter" ? S.lfoDepth*4000 : 0, AC.currentTime, .02);
}
function applyFilter(){
  if(!lp) return;
  lp.frequency.setTargetAtTime(cutoffHz(), AC.currentTime, .015);
  lp.Q.setTargetAtTime(biquadQ(), AC.currentTime, .015);
}

/* ---------- voices ---------- */
var voices={};          /* key: midi → {osc,g} */
function voiceOn(m){
  ensurePower(); if(!AC) return;
  voiceOff(m,true);
  var t=AC.currentTime;
  var osc=AC.createOscillator();
  osc.type=S.wave;
  osc.detune.value=S.detune;
  var f=mtof(m);
  if(S.glide>4 && lastMidi!=null && m!==lastMidi){
    var f0=Math.max(20,mtof(lastMidi));
    osc.frequency.setValueAtTime(f0,t);
    osc.frequency.exponentialRampToValueAtTime(f,t+S.glide/1000);
  }else{
    osc.frequency.setValueAtTime(f,t);
  }
  lastMidi=m;
  var g=AC.createGain();
  g.gain.cancelScheduledValues(t);
  g.gain.setValueAtTime(0.00001,t);
  var a=Math.max(.002,S.attack/1000), d=Math.max(.005,S.decay/1000);
  g.gain.exponentialRampToValueAtTime(1, t+a);                       /* attack to 1 */
  g.gain.exponentialRampToValueAtTime(Math.max(.002,S.sustain), t+a+d); /* decay to sustain */
  osc.connect(g); g.connect(lp);
  lfoPitch.connect(osc.detune);      /* LFO depth rides on the detune AudioParam */
  osc.start(t);
  voices[m]={osc:osc,g:g};
  if(sigLedEl) sigLedEl.classList.add("on");
}
function voiceOff(m, keepLast){
  var v=voices[m]; if(!v||!AC) return;
  delete voices[m];
  var t=AC.currentTime;
  var r=Math.max(.02,S.release/1000);
  try{
    var cur=Math.max(v.g.gain.value, .0002);
    v.g.gain.cancelScheduledValues(t);
    v.g.gain.setValueAtTime(cur,t);
    v.g.gain.exponentialRampToValueAtTime(0.0002, t+r);
  }catch(e){}
  v.osc.stop(t+r+.06);
  if(!keepLast && lastMidi===m) lastMidi=anyVoiceMidi()!==null?anyVoiceMidi():lastMidi;
  checkIdle();
}
function anyVoiceMidi(){
  for(var k in voices) return +k;
  return null;
}
function checkIdle(){
  if(!sigLedEl) return;
  var busy=Object.keys(voices).length>0 || Object.keys(held).length>0 || arpLive.length>0;
  if(!busy) sigLedEl.classList.remove("on");
}

/* =========================================================
   NOTE LOGIC (held set, arp-aware)
   ========================================================= */
var held={};            /* midi → true when key held (source-agnostic) */
var keyEls=[];          /* index (0..24) → element */
var BASE=48;            /* C3 */
var arpLive=[];         /* midi currently gated by arpeggiator */
var arpTimer=null, arpIdx=0, arpStepIv=0, ledTimer=null;

function setKeyLit(m,on){
  var el=keyEls[m-BASE];
  if(el) el.classList.toggle("on", !!on);
}
function press(m, src){
  m=clamp(m,0,127);
  if(held[m]) return;
  held[m]=true;
  setKeyLit(m,true);
  if(!S.arp) voiceOn(m);
  checkIdle();
}
function release(m, src){
  if(!held[m]) return;
  delete held[m];
  if(!S.arp){ voiceOff(m); }
  setKeyLit(m,false);
  checkIdle();
}
function releaseAll(){
  for(var m in held){ m=+m; delete held[m]; voiceOff(m); setKeyLit(m,false); }
  checkIdle();
}

/* ---------- arpeggiator ---------- */
function heldNotes(){
  var a=[]; for(var m in held) a.push(+m);
  a.sort(function(x,y){ return x-y; });
  return a;
}
function nextArpNote(notes){
  if(!notes.length) return null;
  if(S.arpPattern==="rnd"){
    return notes[Math.floor(Math.random()*notes.length)];
  }
  if(S.arpPattern==="up"){
    var n=notes[arpIdx%notes.length]; arpIdx++; return n;
  }
  var dn=notes.slice().reverse();
  var d=dn[arpIdx%dn.length]; arpIdx++; return d;
}
function lightLed(i){
  var leds=document.getElementById("stepLeds").children;
  for(var j=0;j<leds.length;j++) leds[j].classList.toggle("on", j===i%8);
  clearTimeout(ledTimer);
  ledTimer=setTimeout(function(){ for(var j=0;j<leds.length;j++) leds[j].classList.remove("on"); }, arpStepIv*0.55);
}
var arpGen=0;
function arpStep(){
  /* release previous gated notes */
  var gen=++arpGen;
  for(var i=0;i<arpLive.length;i++){ voiceOff(arpLive[i]); }
  arpLive=[];
  var notes=heldNotes();
  if(!notes.length){ return; }
  var m=nextArpNote(notes);
  voiceOn(m);
  arpLive.push(m);
  lightLed(arpIdx);
  var gateMs=arpStepIv*(S.gate);
  setTimeout(function(){
    if(gen!==arpGen) return;               /* a newer step owns the voice now */
    var k=arpLive.indexOf(m);
    if(k>-1) arpLive.splice(k,1);
    voiceOff(m); checkIdle();
  }, Math.max(20,gateMs));
}
function restartArp(){
  if(arpTimer){ clearInterval(arpTimer); arpTimer=null; }
  if(!S.arp) return;
  arpStepIv=60000/S.tempo/2;           /* eighth notes */
  arpStep();
  arpTimer=setInterval(arpStep, arpStepIv);
}
function arpStopAllNotes(){
  arpGen++;
  for(var i=0;i<arpLive.length;i++) voiceOff(arpLive[i]);
  arpLive=[];
}

/* =========================================================
   KNOBS
   ========================================================= */
function fmtHz(f){ return f>=1000 ? (f/1000).toFixed(f>=10000?1:2).replace(/0+$/,"").replace(/\.$/,"")+" kHz" : Math.round(f)+" Hz"; }
function fmtMs(ms){ return ms>=1000 ? (ms/1000).toFixed(2)+" s" : Math.round(ms)+" ms"; }

function makeKnob(parent, spec){
  var cell=document.createElement("div"); cell.className="knob-cell";
  var lab=document.createElement("div"); lab.className="k-label"; lab.textContent=spec.label;
  var k=document.createElement("div"); k.className="knob"; k.tabIndex=0;
  k.setAttribute("role","slider");
  k.setAttribute("aria-label",spec.label);
  k.setAttribute("aria-valuemin","0"); k.setAttribute("aria-valuemax","100");
  var val=document.createElement("div"); val.className="k-val mono";
  cell.appendChild(lab); cell.appendChild(k); cell.appendChild(val);
  parent.appendChild(cell);
  var t=spec.get();
  var dirty=false;
  function paint(){
    k.style.transform="rotate("+(-135+t*270)+"deg)";
    var txt=spec.fmt(clamp(t,0,1));
    val.textContent=txt;
    k.setAttribute("aria-valuenow", String(Math.round(t*100)));
    k.setAttribute("aria-valuetext", txt);
    dirty=false;
    spec.onInput(clamp(t,0,1));
  }
  function schedulePaint(){ if(!dirty){ dirty=true; requestAnimationFrame(paint); } }
  paint();
  var dragY=null, dragT=0;
  k.addEventListener("pointerdown", function(e){
    ensurePower();
    k.setPointerCapture(e.pointerId);
    dragY=e.clientY; dragT=t;
    e.preventDefault();
  });
  k.addEventListener("pointermove", function(e){
    if(dragY===null) return;
    t=clamp(dragT+(dragY-e.clientY)/160, 0, 1);   /* 160px full travel */
    schedulePaint();
  });
  function up(e){ if(dragY!==null){ dragY=null; } }
  k.addEventListener("pointerup", up);
  k.addEventListener("pointercancel", up);
  k.addEventListener("wheel", function(e){
    e.preventDefault();
    ensurePower();
    t=clamp(t + (e.deltaY<0?1:-1)*(e.shiftKey?.1:.02), 0, 1);
    schedulePaint();
  }, {passive:false});
  k.addEventListener("keydown", function(e){
    var step=e.shiftKey?.1:.01;
    if(e.key==="ArrowUp"||e.key==="ArrowRight"){ t=clamp(t+step,0,1); schedulePaint(); e.preventDefault(); }
    else if(e.key==="ArrowDown"||e.key==="ArrowLeft"){ t=clamp(t-step,0,1); schedulePaint(); e.preventDefault(); }
  });
  return {set:function(v){ t=clamp(v,0,1); paint(); }};
}

/* Oscillator knobs */
makeKnob(document.getElementById("knobs-osc"), { label:"Detune",
  get:function(){ return (S.detune+100)/200; },
  fmt:function(t){ var c=Math.round(t*200-100); return (c>0?"+":"")+c+" ¢"; },
  onInput:function(t){ S.detune=Math.round(t*200-100);
    for(var m in voices) voices[m].osc.detune.value=S.detune; }
});
makeKnob(document.getElementById("knobs-osc"), { label:"Glide",
  get:function(){ return Math.sqrt(S.glide/500); },
  fmt:function(t){ return fmtMs(t*t*500); },
  onInput:function(t){ S.glide=t*t*500; }
});
/* Envelope knobs */
makeKnob(document.getElementById("knobs-env"), { label:"Attack",
  get:function(){ return Math.sqrt((S.attack-2)/1498); },
  fmt:function(t){ return fmtMs(2+t*t*1498); },
  onInput:function(t){ S.attack=2+t*t*1498; redrawEnv(); }
});
makeKnob(document.getElementById("knobs-env"), { label:"Decay",
  get:function(){ return Math.sqrt((S.decay-20)/2480); },
  fmt:function(t){ return fmtMs(20+t*t*2480); },
  onInput:function(t){ S.decay=20+t*t*2480; redrawEnv(); }
});
makeKnob(document.getElementById("knobs-env"), { label:"Sustain",
  get:function(){ return S.sustain; },
  fmt:function(t){ return Math.round(t*100)+" %"; },
  onInput:function(t){ S.sustain=t; redrawEnv(); }
});
makeKnob(document.getElementById("knobs-env"), { label:"Release",
  get:function(){ return Math.sqrt((S.release-40)/3960); },
  fmt:function(t){ return fmtMs(40+t*t*3960); },
  onInput:function(t){ S.release=40+t*t*3960; redrawEnv(); }
});
/* Filter knobs */
makeKnob(document.getElementById("knobs-flt"), { label:"Cutoff",
  get:function(){ return S.cutoff; },
  fmt:function(t){ return fmtHz(60 + (16000-60)*t*t*t); },
  onInput:function(t){ S.cutoff=t; applyFilter(); redrawFlt(); }
});
makeKnob(document.getElementById("knobs-flt"), { label:"Resonance",
  get:function(){ return S.reso/24; },
  fmt:function(t){ return (t*24).toFixed(1)+" dB"; },
  onInput:function(t){ S.reso=t*24; applyFilter(); redrawFlt(); }
});
/* LFO knobs */
makeKnob(document.getElementById("knobs-lfo"), { label:"Rate",
  get:function(){ return Math.sqrt((S.lfoRate-.05)/13.95); },
  fmt:function(t){ var f=.05+t*t*13.95; return f<10 ? f.toFixed(2)+" Hz" : f.toFixed(1)+" Hz"; },
  onInput:function(t){ S.lfoRate=.05+t*t*13.95;
    if(lfo) lfo.frequency.setTargetAtTime(S.lfoRate, AC.currentTime, .02); }
});
makeKnob(document.getElementById("knobs-lfo"), { label:"Depth",
  get:function(){ return S.lfoDepth; },
  fmt:function(t){ return Math.round(t*100)+" %"; },
  onInput:function(t){ S.lfoDepth=t; applyLfoGains(); }
});
/* Arp knobs */
makeKnob(document.getElementById("knobs-arp"), { label:"Tempo",
  get:function(){ return (S.tempo-40)/200; },
  fmt:function(t){ return Math.round(40+t*200)+" bpm"; },
  onInput:function(t){ S.tempo=Math.round(40+t*200); if(S.arp) restartArp(); }
});
makeKnob(document.getElementById("knobs-arp"), { label:"Gate",
  get:function(){ return S.gate; },
  fmt:function(t){ return Math.round(t*100)+" %"; },
  onInput:function(t){ S.gate=t; }
});
/* Master */
makeKnob(document.getElementById("knobs-mst"), { label:"Volume",
  get:function(){ return S.volume; },
  fmt:function(t){ return Math.round(t*100)+" %"; },
  onInput:function(t){ S.volume=t; if(master) master.gain.setTargetAtTime(t, AC.currentTime, .015); }
});

/* =========================================================
   SCREENS
   ========================================================= */
function fitCanvas(cv){
  var r=cv.getBoundingClientRect(), d=window.devicePixelRatio||1;
  var w=Math.max(2,Math.round(r.width*d)), h=Math.max(2,Math.round(r.height*d));
  if(cv.width!==w||cv.height!==h){ cv.width=w; cv.height=h; }
  var c=cv.getContext("2d"); c.setTransform(d,0,0,d,0,0);
  return {c:c,w:r.width,h:r.height};
}
function redrawEnv(){
  var el=document.getElementById("envCanvas"); if(!el) return;
  var f=fitCanvas(el), c=f.c, W=f.w, H=f.h;
  c.clearRect(0,0,W,H);
  var a=Math.max(.02,S.attack/1000), d=Math.max(.02,S.decay/1000), r=Math.max(.05,S.release/1000);
  var hold=.6;
  var pts=[[0,0],[a,1],[a+d,S.sustain],[a+d+hold,S.sustain],[a+d+hold+r,0]];
  var tot=a+d+hold+r;
  function X(t){ return 8+t/tot*(W-16); }
  function Y(v){ return (H-8)-v*(H-16); }
  c.beginPath();
  c.moveTo(X(0),Y(0));
  for(var i=1;i<pts.length;i++) c.lineTo(X(pts[i][0]),Y(pts[i][1]));
  c.lineTo(X(tot),Y(0)); c.closePath();
  var grad=c.createLinearGradient(0,0,0,H);
  grad.addColorStop(0,"rgba(96,236,138,.38)"); grad.addColorStop(1,"rgba(96,236,138,.04)");
  c.fillStyle=grad; c.fill();
  c.beginPath(); c.moveTo(X(0),Y(0));
  for(i=1;i<pts.length;i++) c.lineTo(X(pts[i][0]),Y(pts[i][1]));
  c.strokeStyle="#60ec8a"; c.lineWidth=1.6;
  c.shadowColor="rgba(96,236,138,.9)"; c.shadowBlur=6; c.stroke(); c.shadowBlur=0;
}
function bjLowpassMagDb(freq,f0,Q,fs){
  var w=2*Math.PI*freq/fs, w0=2*Math.PI*f0/fs;
  var alpha=Math.sin(w0)/(2*Q);
  var b0=(1-Math.cos(w0))/2, b1=1-Math.cos(w0), b2=b0;
  var a0=1+alpha, a1=-2*Math.cos(w0), a2=1-alpha;
  var cosw=Math.cos(w), sinw=Math.sin(w), cos2=Math.cos(2*w), sin2=Math.sin(2*w);
  var nr=b0+b1*cosw+b2*cos2, ni=-(b1*sinw+b2*sin2);
  var dr=a0+a1*cosw+a2*cos2, di=-(a1*sinw+a2*sin2);
  var num=nr*nr+ni*ni, den=dr*dr+di*di;
  return 10*Math.log10(Math.max(num/den, 1e-9));
}
function redrawFlt(){
  var el=document.getElementById("fltCanvas"); if(!el) return;
  var f=fitCanvas(el), c=f.c, W=f.w, H=f.h;
  c.clearRect(0,0,W,H);
  var f0=20, f1=20000, dbTop=18, dbBot=-48;
  function FX(fr){ return 6+Math.log(fr/f0)/Math.log(f1/f0)*(W-12); }
  function DY(db){ return 4+(dbTop-clamp(db,dbBot,dbTop))/(dbTop-dbBot)*(H-8); }
  c.strokeStyle="rgba(125,255,176,.09)"; c.lineWidth=1;
  [50,100,500,1000,5000,10000].forEach(function(fr){
    c.beginPath(); c.moveTo(FX(fr),2); c.lineTo(FX(fr),H-10); c.stroke(); });
  [0,-12,-24,-36].forEach(function(db){
    c.beginPath(); c.moveTo(4,DY(db)); c.lineTo(W-4,DY(db)); c.stroke(); });
  c.font="7.5px ui-monospace, Consolas, monospace"; c.fillStyle="rgba(125,255,176,.4)";
  c.fillText("0dB", 5, DY(0)-2); c.fillText("-24dB", 5, DY(-24)-2);
  ["50","100","500","1k","5k","10k"].forEach(function(l,i){
    var fr=[50,100,500,1000,5000,10000][i];
    c.fillText(l, FX(fr)-7, H-2); });
  var fs=AC?AC.sampleRate:44100, fc=cutoffHz(), Q=biquadQ();
  c.beginPath();
  for(var i=0;i<=90;i++){
    var fr=f0*Math.pow(f1/f0,i/90);
    var db=bjLowpassMagDb(fr,fc,Q,fs);
    var x=FX(fr), y=DY(db);
    if(i===0)c.moveTo(x,y); else c.lineTo(x,y);
  }
  c.strokeStyle="#7dffb0"; c.lineWidth=1.5;
  c.shadowColor="rgba(125,255,176,.85)"; c.shadowBlur=5; c.stroke(); c.shadowBlur=0;
}
redrawEnv(); redrawFlt();

/* =========================================================
   BUTTON GROUPS
   ========================================================= */
function wireRadioGroup(attr, apply){
  var btns=document.querySelectorAll("["+attr+"]");
  btns.forEach(function(b){
    b.addEventListener("click", function(){
      ensurePower();
      btns.forEach(function(x){ x.setAttribute("aria-pressed", x===b ? "true":"false"); });
      apply(b.getAttribute(attr));
    });
  });
}
wireRadioGroup("data-wave", function(w){
  S.wave=w;
  for(var m in voices) voices[m].osc.type=w;
});
wireRadioGroup("data-lfo-target", function(t){ S.lfoTarget=t; applyLfoGains(); });
wireRadioGroup("data-lfo-shape", function(sh){
  S.lfoShape=sh;
  if(lfo){ try{ lfo.type=sh; }catch(e){} }
});
wireRadioGroup("data-arp", function(p){
  S.arpPattern=p; arpIdx=0;
});
var arpBtn=document.getElementById("arpBtn");
arpBtn.addEventListener("click", function(){
  ensurePower();
  S.arp=!S.arp;
  arpBtn.setAttribute("aria-pressed", S.arp?"true":"false");
  if(S.arp){
    /* release any sustain-held voices, start stepping */
    for(var m in held) voiceOff(+m);
    restartArp();
  }else{
    if(arpTimer){ clearInterval(arpTimer); arpTimer=null; }
    arpStopAllNotes();
    for(var k in held) voiceOn(+k);     /* hand back to sustain */
    checkIdle();
  }
});

/* =========================================================
   KEYBOARD
   ========================================================= */
var keysEl=document.getElementById("keys");
var LOWER="Z S X D C V G B H N J M".split(" ");
var UPPER="Q 2 W 3 E R 5 T 6 Y 7 U I".split(" ");
var WHITE_PATTERN=[0,2,4,5,7,9,11];
var LEGEND=[]; (function(){
  var lo={0:"Z",1:"S",2:"X",3:"D",4:"C",5:"V",6:"G",7:"B",8:"H",9:"N",10:"J",11:"M"};
  var up={12:"Q",13:"2",14:"W",15:"3",16:"E",17:"R",18:"5",19:"T",20:"6",21:"Y",22:"7",23:"U",24:"I"};
  for(var i=0;i<25;i++) LEGEND.push(lo[i]||up[i]);
})();
function buildKeys(){
  keysEl.innerHTML="";
  keyEls=[];
  /* white keys */
  var whiteCount=0, whitePositions=[];
  for(var i=0;i<25;i++){
    var semi=i%12;
    if([0,2,4,5,7,9,11].indexOf(semi)>-1) whitePositions.push(i);
  }
  var W=whitePositions.length; /* 15 */
  for(i=0;i<W;i++){
    var idx=whitePositions[i];
    var k=document.createElement("div");
    k.className="key w"; k.dataset.semi=idx;
    var lg=document.createElement("span"); lg.className="legend mono"; lg.textContent=LEGEND[idx];
    var nt=document.createElement("span"); nt.className="note"; nt.textContent=noteName(BASE+idx);
    k.appendChild(lg); k.appendChild(nt);
    keysEl.appendChild(k);
    keyEls[idx]=k;
  }
  /* black keys */
  var bw=62/W; /* % of container = 62% of one white width */
  for(i=0;i<25;i++){
    var s=i%12;
    if([1,3,6,8,10].indexOf(s)===-1) continue;
    var whitesBefore=whitePositions.filter(function(w){ return w<i; }).length;
    var k2=document.createElement("div");
    k2.className="key b"; k2.dataset.semi=i;
    k2.style.width="calc("+bw+"% / 1)";
    k2.style.width=bw+"%";
    k2.style.left="calc("+(whitesBefore*(100/W))+"% + "+((100/W)*(1-.62)/2)+"%)";
    var lg2=document.createElement("span"); lg2.className="legend mono"; lg2.textContent=LEGEND[i];
    k2.appendChild(lg2);
    keysEl.appendChild(k2);
    keyEls[i]=k2;
  }
}
function refreshLabels(){
  for(var i=0;i<25;i++){
    var el=keyEls[i]; if(!el) continue;
    var n=el.querySelector(".note");
    if(n) n.textContent=noteName(BASE+i);
  }
  var rd=document.getElementById("octReadout");
  var sign=S.octave>0?"+"+(S.octave*12):(S.octave<0?(S.octave*12):"±0");
  rd.textContent="oct "+sign+" · "+noteName(BASE)+"–"+noteName(BASE+24);
}
function shiftOctave(dir){
  var nb=clamp(BASE+dir*12, 24, 96);
  if(nb===BASE) return;
  releaseAll();
  BASE=nb;
  S.octave=(nb-48)/12;
  refreshLabels();
}
document.getElementById("octDown").addEventListener("click", function(){ ensurePower(); shiftOctave(-1); });
document.getElementById("octUp").addEventListener("click", function(){ ensurePower(); shiftOctave(1); });
buildKeys(); refreshLabels();

function midiOf(el){ return BASE + (el? +el.dataset.semi : 0); }

/* pointer play — capture + elementFromPoint → glissando; pointer map → multitouch */
var pointers={};
keysEl.addEventListener("pointerdown", function(e){
  var key=e.target.closest ? e.target.closest(".key") : null;
  if(!key) return;
  ensurePower();
  keysEl.setPointerCapture(e.pointerId);
  var m=midiOf(key);
  pointers[e.pointerId]={m:m, el:key};
  press(m);
  e.preventDefault();
});
keysEl.addEventListener("pointermove", function(e){
  var p=pointers[e.pointerId]; if(!p) return;
  var under=document.elementFromPoint(e.clientX,e.clientY);
  var key=under && under.closest ? under.closest(".key") : null;
  if(!key) return;
  var m=midiOf(key);
  if(m!==p.m){
    release(p.m);
    press(m);
    p.m=m; p.el=key;
  }
});
function pointerUp(e){
  var p=pointers[e.pointerId]; if(!p) return;
  release(p.m);
  delete pointers[e.pointerId];
}
keysEl.addEventListener("pointerup", pointerUp);
keysEl.addEventListener("pointercancel", pointerUp);

/* computer keyboard */
var CODE2SEMI={
  KeyZ:0,KeyS:1,KeyX:2,KeyD:3,KeyC:4,KeyV:5,KeyG:6,KeyB:7,KeyH:8,KeyN:9,KeyJ:10,KeyM:11,
  KeyQ:12,Digit2:13,KeyW:14,Digit3:15,KeyE:16,KeyR:17,Digit5:18,KeyT:19,Digit6:20,KeyY:21,Digit7:22,KeyU:23,KeyI:24
};
var codeDown={};
document.addEventListener("keydown", function(e){
  if(e.metaKey||e.ctrlKey||e.altKey) return;
  var semi=CODE2SEMI[e.code];
  if(semi===undefined){
    /* first key interaction still powers the unit if a key was meant for play */
    return;
  }
  if(e.repeat || codeDown[e.code]) return;   /* Set-style tracking to avoid auto-repeat */
  codeDown[e.code]=true;
  e.preventDefault();
  ensurePower();
  press(BASE+semi);
}, false);
document.addEventListener("keyup", function(e){
  var semi=CODE2SEMI[e.code];
  if(semi===undefined) return;
  if(!codeDown[e.code]) return;
  delete codeDown[e.code];
  release(BASE+semi);
});
window.addEventListener("blur", function(){
  for(var c in codeDown){ delete codeDown[c]; }
  releaseAll();
});

/* =========================================================
   OSCILLOSCOPE
   ========================================================= */
sigLedEl=document.getElementById("sigLed");
var scopeEl=document.getElementById("scopeCanvas");
var reduced=window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
var lastScope=0;
function drawScope(now){
  var f=fitCanvas(scopeEl), c=f.c, W=f.w, H=f.h, mid=H/2;
  c.clearRect(0,0,W,H);
  /* grid */
  c.strokeStyle="rgba(125,255,176,.08)"; c.lineWidth=1; c.beginPath();
  for(var gx=1;gx<8;gx++){ c.moveTo(W*gx/8,0); c.lineTo(W*gx/8,H); }
  for(var gy=1;gy<4;gy++){ c.moveTo(0,H*gy/4); c.lineTo(W,H*gy/4); }
  c.stroke();
  c.strokeStyle="rgba(125,255,176,.16)";
  c.beginPath(); c.moveTo(0,mid); c.lineTo(W,mid); c.stroke();

  var label=null, samples=null;
  if(!powered){ label="NO SIGNAL"; }
  else{
    analyser.getFloatTimeDomainData(scopeBuf);
    var peak=0;
    for(var i=0;i<scopeBuf.length;i++){ var a=Math.abs(scopeBuf[i]); if(a>peak) peak=a; }
    if(peak<.006){ label="IDLE"; }
    else{
      /* rising zero-crossing trigger */
      var trig=-1, N=scopeBuf.length, skip=Math.floor(N*.1);
      for(i=skip;i<N-1;i++){
        if(scopeBuf[i]<=0 && scopeBuf[i+1]>0){ trig=i; break; }
      }
      if(trig<0) trig=0;
      samples={buf:scopeBuf, from:trig, span:Math.min(N-trig-1, Math.floor(N*.45)), amp:peak};
    }
  }
  if(label){
    c.strokeStyle="rgba(125,255,176,.28)"; c.lineWidth=1; c.beginPath();
    var j0=Math.sin(now/40)*1.2 + (Math.random()-.5)*.9;
    c.moveTo(4, mid+j0); c.lineTo(W-4, mid+j0+ (Math.random()-.5)*.9);
    c.stroke();
    c.font="9px ui-monospace, Consolas, monospace";
    c.fillStyle="rgba(125,255,176,.42)";
    c.fillText(label+" · awaiting input", 9, 13);
  }else{
    var s=samples, n=s.span, stepX=W/n;
    c.strokeStyle="#7dffb0"; c.lineWidth=1.5;
    c.shadowColor="rgba(125,255,176,.8)"; c.shadowBlur=7;
    c.beginPath();
    for(var x=0;x<n;x++){
      var y=mid - s.buf[s.from+x]*mid*.92;
      if(x===0) c.moveTo(0,y); else c.lineTo(x*stepX,y);
    }
    c.stroke(); c.shadowBlur=0;
  }
}
function loop(now){
  if(!reduced || now-lastScope>60){
    lastScope=now;
    drawScope(now);
  }
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
window.addEventListener("resize", function(){ redrawEnv(); redrawFlt(); });

/* power on the very first click anywhere in the panel (pointer), keys handled above */
document.querySelector(".panel").addEventListener("pointerdown", function(){ ensurePower(); }, {once:true});
document.addEventListener("keydown", function h(e){
  if(CODE2SEMI[e.code]!==undefined){ ensurePower(); document.removeEventListener("keydown",h); }
});
})();
</script>


</body></html>
